/**
 * dsh-math �?���?��收脚�?��不依�?DSH 宿主）�?? *
 * �?��：在没有宿主的情况下，用真实�?Python 引擎跑�?? *   「插件入�?�?14 �?��具注�?�?参数校验 �?参数组�? �?Python 引擎 �?结构化渲染�?? * 全链�?��并�?查：缓存复用、重复失败拦�??�非法参数报错�?�各模块代表性结果�?? *
 * 用法（node 在本机不�?PATH，用 Electron �?node）：
 *   $env:ELECTRON_RUN_AS_NODE=1
 *   & "D:\deepseek_harness\DeepSeek Harness.exe" E:\dsh-math\_verify\harness.mjs
 */

import { spawn } from "node:child_process";
import { pathToFileURL } from "node:url";

const ENTRY = pathToFileURL("E:/dsh-math/plugin/lib/entry.js").href;

/* ------------------------------------------------------------------ �?subprocess 服务 */
function createSubprocessShim() {
  return {
    async resolveExecutable(command) {
      const configured = process.env.DSH_MATH_PYTHON;
      if (configured) return configured;
      return command;
    },
    spawn(spec) {
      const [program, ...rest] = spec.argv;
      const child = spawn(program, rest, {
        cwd: spec.cwd,
        stdio: ["pipe", "pipe", "pipe"],
        windowsHide: true,
      });
      const stderrChunks = [];
      child.stderr?.on("data", (chunk) => {
        stderrChunks.push(chunk);
        if (stderrChunks.length > 200) stderrChunks.shift();
      });
      let exited = false;
      const exitWaiters = [];
      child.on("exit", () => {
        exited = true;
        for (const waiter of exitWaiters) waiter();
      });
      return {
        stdin: child.stdin,
        stdout: child.stdout,
        stderr: undefined, // collect 模式：stderr �?collected 上（�?DSH 行为�?致）
        control: {},
        collected: {
          stderr: {
            readFrom: () => ({
              text: Buffer.concat(stderrChunks).toString("utf8"),
              nextOffset: 0,
              lossy: false,
            }),
            snapshot: () => ({ bytes: 0, totalBytes: 0 }),
          },
        },
        done: new Promise((resolve, reject) => {
          child.on("exit", (code) => (code === 0 ? resolve({ code }) : reject(new Error(`exit ${code}`))));
          child.on("error", reject);
        }),
        terminate: () => child.kill(),
        terminateForHostExit: () => child.kill(),
        waitForExit: () =>
          exited ? Promise.resolve() : new Promise((resolve) => exitWaiters.push(resolve)),
      };
    },
  };
}

/* ------------------------------------------------------------------ �?ctx */
function createContext(disposers, registered, sections) {
  const shim = createSubprocessShim();
  return {
    get: (name) => (name === "subprocess" ? shim : undefined),
    effect: (fn) => {
      disposers.push(fn());
    },
    logger: { debug: () => {}, info: () => {}, warn: () => {} },
    tools: {
      register: (definition) => {
        registered.set(definition.name, definition);
        return () => registered.delete(definition.name);
      },
    },
    systemPrompt: {
      section: (section) => {
        sections.push(section);
      },
    },
  };
}

/* ------------------------------------------------------------------ 测试驱动 */
const disposers = [];
const registered = new Map();
const sections = [];
const results = [];

let plugin;

async function callTool(name, args) {
  const definition = registered.get(name);
  if (!definition) throw new Error(`工具�?��册：${name}`);
  const value = await definition.execute(args, { signal: undefined });
  const blocks = definition.output.render(args, value);
  return blocks.map((block) => block.text ?? "").join("\n");
}

async function check(label, name, args, expectations) {
  const started = Date.now();
  let text;
  let failed = null;
  try {
    text = await callTool(name, args);
  } catch (error) {
    failed = `${error?.name}: ${error?.message}`;
  }
  const elapsed = Date.now() - started;
  const problems = [];
  if (failed) {
    problems.push(`抛错 ${failed}`);
  } else {
    for (const expected of expectations) {
      if (!text.includes(expected)) problems.push(`缺少 «${expected}»`);
    }
  }
  const ok = problems.length === 0;
  results.push({ label, ok, elapsed, problems, text });
  console.log(`${ok ? "[PASS]" : "[FAIL]"} ${label}�?{elapsed}ms）`);
  if (!ok) {
    console.log(`       �??�?{problems.join("�?)}`);
    console.log(
      `       实际输出：\n${String(text ?? failed)
        .split("\n")
        .map((line) => `         ${line}`)
        .join("\n")}`,
    );
  }
  return text;
}

async function main() {
  plugin = await import(ENTRY);
  console.log(`插件入口加载成功�?{Object.keys(plugin).join(", ")}`);
  console.log(`inject = ${JSON.stringify(plugin.inject)}`);

  plugin.apply(createContext(disposers, registered, sections), {});
  console.log(`已注册工�?${registered.size} �?��${[...registered.keys()].join(", ")}`);
  console.log(`系统提示 section�?{sections.map((section) => `${section.name}@${section.order}`).join(", ")}`);

  // 参数 schema 形�?�核查（DSH �?��受受限子集）
  for (const [toolName, definition] of registered) {
    if (definition.parameters.type !== "object" || typeof definition.output.render !== "function") {
      throw new Error(`工具 ${toolName} 的定义形态不对`);
    }
    if (definition.output.schema.type !== "string") throw new Error(`工具 ${toolName} �?output schema 不�?`);
    for (const [key, node] of Object.entries(definition.parameters.properties)) {
      if (typeof node.type !== "string") throw new Error(`${toolName}.${key} 缺少 type`);
      if (Object.hasOwn(node, "required") && node.required !== undefined) {
        throw new Error(`${toolName}.${key} 编译后仍�?required 键`);
      }
    }
  }
  console.log("参数 schema 形�?�核查�?�过（object + 每项单一 type�?);

  console.log("\n--- �?��动引擎时的状态查�?---");
  await check("math_status（引擎未�?���?, "math_status", { action: "status" }, ["引擎尚未�?��"]);

  console.log("\n--- 高数：极�?导数/�?��/级数/�?��方程 ---");
  await check("定积�?�?��¹x²dx", "math_integrate", { expr: "x^2", lower: "0", upper: "1" }, ["1/3"]);
  const beforeCache = await callTool("math_status", { action: "cache_stats" });
  await check("同一�?���?��次调�?��应命�?��存）", "math_integrate", { expr: "x^2", lower: "0", upper: "1" }, ["1/3"]);
  const afterCache = await callTool("math_status", { action: "cache_stats" });
  const hitsOf = (text) => {
    const matched = /命中 (\d+)/.exec(text);
    return matched ? Number(matched[1]) : NaN;
  };
  const cacheOk = hitsOf(afterCache) > hitsOf(beforeCache);
  console.log(`${cacheOk ? "[PASS]" : "[FAIL]"} 缓存命中数�?加（${hitsOf(beforeCache)} �?${hitsOf(afterCache)}）`);
  if (!cacheOk) {
    results.push({ label: "缓存命中数�?�?, ok: false, problems: ["命中数未增加"], text: afterCache });
  } else {
    results.push({ label: "缓存命中数�?�?, ok: true, problems: [], text: "" });
  }

  await check("不定�?�� ∫x·e^{x²}dx", "math_integrate", { expr: "x*exp(x^2)" }, ["exp(x**2)"]);
  await check("�?�� ∫dx/(1+x²)", "math_integrate", { expr: "1/(1+x^2)" }, ["atan(x)"]);
  await check("反常�?�� �?��^∞sin(x)/x", "math_integrate", { expr: "sin(x)/x", lower: "0", upper: "oo" }, ["pi/2"]);
  await check("发散反常�?�� �?��^∞dx/x", "math_integrate", { expr: "1/x", lower: "1", upper: "oo" }, ["oo"]);
  await check("极限 lim sin(x)/x", "math_limit", { expr: "sin(x)/x", var: "x", point: "0" }, ["1"]);
  await check("单侧极限 lim (1/x)", "math_limit", { expr: "1/x", var: "x", point: "0", dir: "+" }, ["oo"]);
  await check("导数 (sin x)'", "math_derivative", { expr: "sin(x)", var: "x" }, ["cos(x)"]);
  await check("二阶�?(x³)''", "math_derivative", { expr: "x^3", var: "x", order: 2 }, ["6*x"]);
  await check("偏�? �?∂x (x²y+y³)", "math_derivative", { expr: "x^2*y+y^3", var: "x", mode: "partial" }, ["2*x*y"]);
  await check("泰勒展开 sin(x) �?x^5", "math_series", { expr: "sin(x)", var: "x", point: "0", order: 5 }, ["x**5"]);
  await check("级数求和 Σ1/n²", "math_series", { expr: "1/n^2", var: "n", mode: "sum" }, ["pi**2/6"]);
  await check("解方�?x²-3x+2=0", "math_solve", { equations: ["x^2-3*x+2=0"] }, ["1", "2"]);
  await check("�?��方程 y'=x·y", "math_dsolve", { equations: ["y' = x*y"] }, ["exp(x**2/2)"]);

  console.log("\n--- 线代 ---");
  await check("行列�?|1 2;3 4|", "math_matrix", { matrix: ["1,2", "3,4"], operation: "det" }, ["-2"]);
  await check("逆矩�?2×2", "math_matrix", { matrix: ["1,2", "3,4"], operation: "inv" }, ["-1"]);
  await check("特征�?[[2,0],[0,3]]", "math_matrix", { matrix: ["2,0", "0,3"], operation: "eigen" }, ["2", "3"]);
  await check("线�?�方程组（唯�?�?x=-4, y=9/2�?, "math_matrix", {
    matrix: ["1,2", "3,4"],
    rhs: "5,6",
    operation: "solve_linear",
  }, ["-4", "9/2"]);

  console.log("\n--- 概率统�? ---");
  await check("标准正�??P(-1<X<1)", "math_probability", {
    kind: "interval",
    dist: "normal",
    params: '{"mu":0,"sigma":1}',
    lower: "-1",
    upper: "1",
  }, ["erf"]);
  await check("泊松分布 P(X=0)", "math_probability", {
    kind: "at",
    dist: "poisson",
    point: "0",
    lam: "2",
  }, ["exp(-2)"]);
  await check("二项分布期望", "math_probability", {
    kind: "expectation",
    dist: "binomial",
    n: "10",
    p: "1/3",
  }, ["10/3"]);

  console.log("\n--- 曲线曲面�?��与三大公�?---");
  await check("格林�?��（单位圆，P=-y,Q=x�?, "math_vector_calculus", {
    mode: "green",
    expr: "-y",
    expr2: "x",
    x_lower: "-1",
    x_upper: "1",
    y_lower_expr: "-sqrt(1-x^2)",
    y_upper_expr: "sqrt(1-x^2)",
  }, ["2*pi"]);

  console.log("\n--- 数�?�与验证 ---");
  await check("数�?�求�?sqrt(2)", "math_numeric", { expr: "sqrt(2)", mode: "eval" }, ["1.414"]);
  await check("�?��验证不定�?��结果", "math_verify", {
    expr: "x*exp(x^2)",
    candidate: "(1/2)*exp(x^2)",
    kind: "integral",
    var: "x",
  }, ["通过"]);
  await check("验证错�?结果（应判定不�?�过�?, "math_verify", {
    expr: "x*exp(x^2)",
    candidate: "exp(x^2)",
    kind: "integral",
    var: "x",
  }, ["�??�过"]);
  await check("函数定义�?sqrt(x-1)/(x-2)", "math_analysis", { expr: "sqrt(x-1)/(x-2)", mode: "domain" }, ["x"]);

  console.log("\n--- 异常�?��：非法参�?/ 重�?失败拦截 ---");
  let invalidArgs = "（未触发�?;
  try {
    await callTool("math_integrate", { lower: "0", upper: "1" });
    invalidArgs = "没有报错";
  } catch (error) {
    invalidArgs = `${error.name}/${error.code}: ${error.message}`;
  }
  const invalidOk = invalidArgs.includes("INVALID_ARGS");
  console.log(`${invalidOk ? "[PASS]" : "[FAIL]"} 缺少必填参数�?���?��${invalidArgs}`);
  results.push({ label: "缺少必填参数�?���?, ok: invalidOk, problems: [], text: invalidArgs });

  await check("无法解析的输入（�?��次）", "math_simplify", { expr: "@@@ not-an-expression @@@" }, ["执�?失败", "invalid_input"]);

  console.log("\n--- 引擎状�?�与算子清单 ---");
  const opsText = await callTool("math_status", { action: "ops" });
  const opMatch = /�?��算子 (\d+) �?.exec(opsText);
  console.log(`${opMatch ? "[PASS]" : "[FAIL]"} 算子清单�?{opMatch ? opMatch[1] : "?"} 个`);
  results.push({
    label: "算子清单�??",
    ok: Boolean(opMatch) && Number(opMatch[1]) > 150,
    problems: opMatch ? [] : ["�?��析出算子数量"],
    text: opsText.slice(0, 400),
  });

  // 关闭：走插件注册�?disposer（会结束 Python 进程�?  for (const dispose of disposers.reverse()) {
    try {
      if (typeof dispose === "function") await dispose();
    } catch {
      // 忽略清理失败
    }
  }

  const failed = results.filter((item) => !item.ok);
  console.log(`\n===== 结果�?{results.length - failed.length}/${results.length} 通过 =====`);
  if (failed.length) {
    for (const item of failed) console.log(`  �?${item.label} —�??${item.problems.join("�?)}`);
    process.exitCode = 1;
  }
}

main().catch((error) => {
  console.error(`harness 失败�?{error?.stack ?? error}`);
  process.exitCode = 1;
});
